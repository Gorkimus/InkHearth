# Copy to .env and fill in. Never commit the real .env.

# --- app ---
PORT=3222
DEFAULT_USER_NAME=Reader
# Set to 1 when serving over https (e.g. through a tunnel) so the session
# cookie gets its Secure flag. Leave empty on plain-http localhost.
COOKIE_SECURE=

# Set to 1 behind a reverse proxy (nginx/caddy/tunnel) so the login rate
# limit sees real client IPs instead of the proxy's.
TRUST_PROXY=

# --- metadata providers ---
# Optional: hardcover.app API token (free, account settings → API).
# Fills missing page counts + real audiobook runtimes, series, genres and
# moods. (Their API has no word counts — word figures are always estimated
# from pages/runtime.)
HARDCOVER_TOKEN=

# --- LLM (For-you recommendations) ---
# OpenAI-compatible endpoint. Server-wide fallback; every member can add a
# personal key under Account → Recommendations, which takes priority. A free
# Google AI Studio key works (aistudio.google.com/apikey — no card needed).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Audiobookshelf (admin library pull) ---
ABS_URL=
ABS_API_TOKEN=
ABS_LIBRARY_ID=
ABS_LIBRARY_NAME=
# Admin-sanctioned extra origins members may link (the admin's ABS_URL is
# always allowed) — the http/LAN escape hatch: origins listed here skip the
# https + public-DNS requirements member servers otherwise must meet. Comma-
# separated origin forms, e.g. http://192.0.2.9:13378 (documentation address).
ABS_LINK_ALLOWLIST=

# --- optional operations ---

# --- optional operations ---
# Header/tab badge for running two instances side by side (e.g. STAGING).
INSTANCE_LABEL=
# Hours between automatic Kobo device polls (0 = manual "Sync now" only).
KOBO_SYNC_HOURS=
# Silent nightly snapshot cadence + how many auto-snapshots to keep (0 = off).
BACKUP_HOURS=
BACKUP_KEEP=
# Nightly janitor: expired login sessions, uploads older than a day (Kobo
# device databases carry live sync credentials), stale data/tmp (0 = off).
CLEANUP_HOURS=
# LAN IP of this host — docker-compose.staging.yml publishes staging on it so
# you can validate at http://<LAN_IP>:3223 without a tunnel. Unset = loopback
# only. (Prod compose is loopback-only by design; the tunnel reaches the
# container over the Docker network, not the published port.)
LAN_IP=

# Optional: free-tier Google Books API key(s) — restores Google as a
# dependable search fallback (keyless quota is 429 on shared IPs). A second
# key (_2) takes over automatically when the first burns its daily quota.
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_API_KEY_2=
