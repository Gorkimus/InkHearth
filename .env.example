# Copy to .env and fill in. Never commit the real .env.
# Everything here is optional — with no .env at all the app boots on defaults
# (port 3222, fresh database, one-time admin claim link in the logs).

# --- app ---
PORT=3222
# Where the SQLite database lives (default: data/booktracker.db, i.e. inside
# the ./data volume in Docker). Point it elsewhere for scratch/test copies.
BT_DB_PATH=
# Name of the account seeded on first boot (yours to claim via the link
# printed in the logs).
DEFAULT_USER_NAME=Reader
# Set to 1 when serving over https (e.g. through a tunnel) so the session
# cookie gets its Secure flag. Leave empty on plain-http localhost.
COOKIE_SECURE=
# Set to 1 behind a reverse proxy (nginx/caddy/tunnel) so the login rate
# limit sees real client IPs instead of the proxy's.
TRUST_PROXY=
# Which interface the published port binds to (docker compose only).
# Default 127.0.0.1 (safe: plain HTTP stays on this machine — put https in
# front for anything else). 0.0.0.0 exposes it to your LAN as plain HTTP.
LISTEN=

# --- metadata providers ---
# Optional: hardcover.app API token (free, account settings → API).
# Fills missing page counts + real audiobook runtimes, series, genres and
# moods. (Their API has no word counts — word figures are always estimated
# from pages/runtime.)
HARDCOVER_TOKEN=
# Optional second token (e.g. a friend's account) — takes over
# automatically when the first burns its daily quota.
HARDCOVER_TOKEN_2=

# --- LLM (For-you recommendations) ---
# OpenAI-compatible endpoint. Server-wide fallback; every member can add a
# personal key under Account → Recommendations, which takes priority. A free
# Google AI Studio key works (aistudio.google.com/apikey — no card needed).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Audiobookshelf ---
# Admin library pull (the import source under Log a book → Import).
ABS_URL=
ABS_API_TOKEN=
ABS_LIBRARY_ID=
# Hours between automatic per-member ABS syncs (1 = hourly; 0 = manual
# "Sync now" only).
ABS_SYNC_HOURS=
# Admin-sanctioned extra origins members may link (the admin's ABS_URL is
# always allowed) — the http/LAN escape hatch: origins listed here skip the
# https + public-DNS requirements member servers otherwise must meet. Comma-
# separated origin forms, e.g. http://192.0.2.9:13378 (documentation address).
ABS_LINK_ALLOWLIST=
# Name of a pre-existing Docker network to join (see docker-compose.abs.yml)
# when something like an Audiobookshelf stack or an https tunnel should reach
# this container by name over plain http.
ABS_NETWORK_NAME=

# --- Discord (the town crier) ---
# Webhook URL of the channel finishes/starts are announced in (channel
# ⚙️ → Integrations → Webhooks). Empty = the crier is off; nothing posts.
DISCORD_WEBHOOK_URL=
# Seconds a member's announcements gather before one post (default 60 —
# a finishing spree becomes "finished 37 books — A, B, C, and 34 more").
DISCORD_BATCH_SECONDS=
# Public URL of this instance, appended to gathered posts as a
# "check them out on InkHearth" link to the reader's shelf.
DISCORD_APP_URL=

# --- optional operations ---
# Header/tab badge for running two instances side by side (e.g. STAGING).
INSTANCE_LABEL=
# Timezone streak days are keyed in (IANA name, e.g. America/Toronto). An
# 11pm reading touch should count for that evening, not the next UTC day —
# unset, days fall back to UTC and evening readers' streaks break.
STREAK_TZ=
# Hours between automatic Kobo device polls (0 = manual "Sync now" only).
KOBO_SYNC_HOURS=
# Silent nightly snapshot cadence + how many auto-snapshots to keep (0 = off).
BACKUP_HOURS=
BACKUP_KEEP=
# Nightly janitor: expired login sessions, uploads older than a day (Kobo
# device databases carry live sync credentials), stale data/tmp (0 = off).
CLEANUP_HOURS=
# Hours between background genre vocab reconciliations (0 = off).
GENRE_SYNC_HOURS=
# Extra host:port entries (comma-separated) the cover-proxy relay may fetch
# from, beyond the built-in CDN allowlist — e.g. a self-hosted image host.
COVER_PROXY_EXTRA_HOSTS=
# LAN IP of this host — docker-compose.staging.yml publishes staging on it so
# you can validate at http://<LAN_IP>:3223 without a tunnel. Unset = loopback
# only. (Prod compose is loopback-only by design; the tunnel reaches the
# container over the Docker network, not the published port.)
LAN_IP=

# Optional: free-tier Google Books API key(s) — restores Google as a
# dependable search fallback (keyless quota is 429 on shared IPs). A second
# key (_2) takes over automatically when the first burns its daily quota.
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_API_KEY_2=
